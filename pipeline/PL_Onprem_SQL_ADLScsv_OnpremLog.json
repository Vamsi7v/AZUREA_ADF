{
	"name": "PL_Onprem_SQL_ADLScsv_OnpremLog",
	"properties": {
		"activities": [
			{
				"name": "CPY_SQL_To_ADLS_csv",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DSOnpremSQL",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_CSV",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "sp_audit_success",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "CPY_SQL_To_ADLS_csv",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[audit].[sploadstatus]",
					"storedProcedureParameters": {
						"dataread": {
							"value": {
								"value": "@activity('CPY_SQL_To_ADLS_csv').output.dataread",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorId": {
							"value": null,
							"type": "String"
						},
						"Errormessage": {
							"value": null,
							"type": "String"
						},
						"loadstatus": {
							"value": {
								"value": "@activity('CPY_SQL_To_ADLS_csv').output.executiondetails[0].status",
								"type": "Expression"
							},
							"type": "String"
						},
						"tablename": {
							"value": {
								"value": "@concat(pipeline().parameters.schemaname,'_',pipeline().parameters.tablename)\n",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_OnpremSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "sp_audit_fail",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "CPY_SQL_To_ADLS_csv",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[audit].[sploadstatus]",
					"storedProcedureParameters": {
						"dataread": {
							"value": {
								"value": "@activity('CPY_SQL_To_ADLS_csv').output.dataread",
								"type": "Expression"
							},
							"type": "String"
						},
						"ErrorId": {
							"value": {
								"value": "@activity('CPY_SQL_To_ADLS_csv').output.errors[0].code",
								"type": "Expression"
							},
							"type": "String"
						},
						"Errormessage": {
							"value": {
								"value": "@activity('CPY_SQL_To_ADLS_csv').output.errors[0].message",
								"type": "Expression"
							},
							"type": "String"
						},
						"loadstatus": {
							"value": {
								"value": "@activity('CPY_SQL_To_ADLS_csv').output.executiondetails[0].status",
								"type": "Expression"
							},
							"type": "String"
						},
						"tablename": {
							"value": {
								"value": "@concat(pipeline().parameters.schemaname,'_',pipeline().parameters.tablename)\n",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_OnpremSQL",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"schemaname": {
				"type": "String",
				"defaultValue": "audit"
			},
			"tablename": {
				"type": "String",
				"defaultValue": "copylog"
			}
		},
		"folder": {
			"name": "TEST_PL"
		},
		"annotations": [],
		"lastPublishTime": "2026-03-09T21:12:05Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}